        prepend apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec709_scene"
        float inputs:intensity = 1
        asset inputs:texture:file = @./textures/color_0C0C0C.exr@
    }

    def Scope "Materials"
    {
        def Material "m_bag_tp_07"
        {
            token outputs:surface.connect = </root/Materials/m_bag_tp_07/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/Materials/m_bag_tp_07/diffuse.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "diffuse"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/bag_tp_07.png@
                color3f outputs:rgb
            }
        }
    }
