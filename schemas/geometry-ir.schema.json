{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topprismdata.github.io/photo-dieline/schemas/geometry-ir.schema.json",
  "title": "PhotoDieline Geometry IR V0.1",
  "type": "object",
  "required": ["meta", "package", "panels", "edges", "features"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["ir_version", "units", "generator"],
      "additionalProperties": false,
      "properties": {
        "ir_version": { "const": "0.1" },
        "units": { "const": "mm" },
        "generator": { "type": "string" },
        "created": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "required": ["type", "params", "template", "photo"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["gable_top"] },
        "params": {
          "type": "object",
          "required": ["W", "D", "Hb", "Hr", "Ef", "fin_gap_mm", "glue_w", "board_t"],
          "additionalProperties": false,
          "properties": {
            "W": { "type": "number", "exclusiveMinimum": 0, "description": "正面板宽 mm" },
            "D": { "type": "number", "exclusiveMinimum": 0, "description": "侧面板宽(深) mm" },
            "Hb": { "type": "number", "exclusiveMinimum": 0, "description": "墙身高 mm" },
            "Hr": { "type": "number", "minimum": 0, "description": "屋脊高(墙顶到脊) mm" },
            "Ef": { "type": "number", "minimum": 0, "description": "脊鳍高 mm" },
            "fin_gap_mm": { "type": "number", "minimum": 0, "description": "双鳍顶缘间距(板厚叠层) mm" },
            "glue_w": { "type": "number", "exclusiveMinimum": 0, "description": "粘口宽 mm" },
            "board_t": { "type": "number", "minimum": 0, "description": "纸板厚 mm" }
          }
        },
        "params_evidence": {
          "type": "object",
          "description": "参数证据状态 (MEASURED/VERIFIED_SOURCE/DERIVED/INFERRED/DEFAULTED)",
          "additionalProperties": {
            "type": "string",
            "enum": ["MEASURED", "VERIFIED_SOURCE", "DERIVED", "INFERRED", "DEFAULTED"]
          }
        },
        "template": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "gable_top" },
            "version": { "const": "0.1" }
          }
        },
        "photo": {
          "type": "object",
          "required": ["path", "sha256", "width_px", "height_px"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "width_px": { "type": "integer", "minimum": 1 },
            "height_px": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "polygon_2d"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["glue", "wall", "slope", "fin", "flap", "gable_end"]
          },
          "polygon_2d": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "wall_of": { "type": "string", "description": "gable_end 所属墙 panel id" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "seg_2d", "fold"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "const": "FOLD" },
          "seg_2d": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "折线段两端点(展开坐标 mm)"
          },
          "fold": {
            "type": "object",
            "required": ["mt_va", "parent", "child"],
            "additionalProperties": false,
            "properties": {
              "mt_va": { "enum": ["MOUNTAIN", "VALLEY", "SCORE"] },
              "parent": { "type": "string" },
              "child": { "type": "string" },
              "target_angle_deg": { "type": "number", "description": "内二面角(可选)" },
              "target_dir_3d": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3,
                "description": "子面板远离折线方向的世界向量(可选, 显式定向)"
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["GLUE_TAB", "BLEED", "CHECK_BAR", "REGISTRATION"] },
          "panel_id": { "type": "string" },
          "offset_mm": { "type": "number" },
          "length_mm": { "type": "number" },
          "position_2d": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
